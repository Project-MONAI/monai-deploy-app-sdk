{
  "apiVersion": "1.0.0",
  "command": "[\"python3\", \"/opt/holoscan/app\"]",
  "description": "GPU-resident nnU-Net TotalSegmentator (43-task registry, selected via HOLOSCAN_TASK; MAP images ship one task per bake — e.g. total 5 parts → 117 classes, or body); CT DICOM in → DICOM-SEG + DICOM-SR sidecars in the output (shipped MAPs disable the debug numpy .npy + emit_meta.json emit via HOLOSCAN_EMIT_NPY=0; the dev default leaves it ON)",
  "environment": {
    "HOLOSCAN_APPLICATION": "/opt/holoscan/app",
    "HOLOSCAN_APP_MANIFEST_PATH": "/etc/holoscan/app.json",
    "HOLOSCAN_CONFIG_PATH": "/var/holoscan/app.yaml",
    "HOLOSCAN_DOCS_PATH": "/opt/holoscan/docs",
    "HOLOSCAN_EMIT_NPY": "0",
    "HOLOSCAN_INPUT_PATH": "input/",
    "HOLOSCAN_LOGS_PATH": "/var/holoscan/logs",
    "HOLOSCAN_MODEL_PATH": "/opt/holoscan/models",
    "HOLOSCAN_OUTPUT_PATH": "output/",
    "HOLOSCAN_PKG_MANIFEST_PATH": "/etc/holoscan/pkg.json",
    "HOLOSCAN_TASK": "body",
    "HOLOSCAN_WORKDIR": "/var/holoscan"
  },
  "input": {
    "formats": null,
    "path": "input/"
  },
  "liveness": null,
  "output": {
    "formats": null,
    "path": "output/"
  },
  "readiness": null,
  "sdk": "monai-deploy",
  "sdkVersion": "1.0",
  "timeout": 0,
  "version": "0.1.0",
  "workingDirectory": "/var/holoscan"
}
